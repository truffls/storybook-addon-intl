{
    "compilerOptions": {
        "esModuleInterop": true,
        "experimentalDecorators": true,
        "incremental": false,
        "isolatedModules": true,
        "jsx": "react",
        "lib": ["esnext", "dom"],
        "module": "preserve",
        "moduleResolution": "bundler",
        "noImplicitAny": true,
        "rootDir": "./src",
        "skipLibCheck": true,
        "target": "esnext",
        "noEmit": true,
        "strict": true
    },
    "include": ["src/**/*"]
}
